<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- Games are read through the folder the user grants in the system's picker.
         The network is used for one thing only, and only after the user has
         agreed to it on the "add a friend" page: sharing activity with friends
         (src/friends.cpp). Without that agreement nothing is sent anywhere. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:glEsVersion="0x00020000" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- The emulators NSW-Home can start (data.cpp, kEmus). Since Android 11 an
         app only sees the packages it names here. -->
    <queries>
        <package android:name="dev.eden.eden_emulator" />
        <package android:name="dev.legacy.eden_emulator" />
        <package android:name="dev.eden.eden_emulator.nightly" />
        <package android:name="dev.legacy.eden_emulator.nightly" />
        <package android:name="dev.eden.eden_nightly" />
        <package android:name="com.miHoYo.Yuanshen" />
        <package android:name="com.miHoYo.Yuanshen.nightly" />
        <package android:name="org.suyu.suyu_emu" />
        <package android:name="org.suyu.suyu_legacy" />
        <package android:name="dev.lemon.lemon_emulator" />
        <package android:name="dev.lemon.lemon_emulator.lite" />
        <package android:name="dev.legacy.lemon_emulator" />
        <package android:name="com.antutu.ABenchMark" />
        <package android:name="org.kenjinx.android" />
        <package android:name="com.garena.game.codm" />
        <package android:name="org.citron.citron_emu" />
        <package android:name="org.citron.citron_emu.ea" />
        <package android:name="org.sudachi.sudachi_emu" />
        <package android:name="org.sudachi.sudachi_emu.ea" />
        <package android:name="org.yuzu.yuzu_emu" />
        <package android:name="org.yuzu.yuzu_emu.ea" />
        <package android:name="skyline.emu" />
        <package android:name="org.stratoemu.strato" />
        <package android:name="org.stratoemu.strato.dev" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:appCategory="game"
        android:theme="@style/NSWHomeTheme">
        <activity
            android:name=".NSWHomeActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:alwaysRetainTaskState="true"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale"
            android:preferMinimalPostProcessing="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
